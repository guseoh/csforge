# Inputs for the production-like Compose stack.
POSTGRES_DB=csforge
POSTGRES_USER=csforge

# Required secret: replace this value before starting the stack.
# change-me is an example placeholder, not a production password.
POSTGRES_PASSWORD=change-me

# The web container binds to loopback by default.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
